<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ChatRenderCLI</AssemblyName>
    <RootNamespace>TwitchDownloaderCLI</RootNamespace>
    <Version>1.56.5</Version>
    <Copyright>Copyright © lay295 and contributors</Copyright>
    <Description>High-performance Twitch chat video renderer</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Platforms>AnyCPU;x64</Platforms>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>default</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="Xabe.FFmpeg.Downloader" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TwitchDownloaderCore\TwitchDownloaderCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TwitchDownloaderCLI.Tests" />
  </ItemGroup>

  <ItemGroup Label="ExcludeRemovedLegacyFiles">
    <Compile Remove="Modes\Download*.cs;Modes\UpdateChat.cs;Modes\InfoHandler.cs;Modes\MergeTs.cs" />
    <Compile Remove="Modes\Arguments\VideoDownloadArgs.cs;Modes\Arguments\ClipDownloadArgs.cs;Modes\Arguments\ChatDownloadArgs.cs;Modes\Arguments\ChatUpdateArgs.cs;Modes\Arguments\InfoArgs.cs;Modes\Arguments\TsMergeArgs.cs" />
  </ItemGroup>

</Project>
